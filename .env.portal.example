# Supabase Auth: personal email/password accounts; backend credentials only.
PORTAL_SUPABASE_URL=https://PROJECT.supabase.co
PORTAL_SUPABASE_PUBLISHABLE_KEY=replace-me
PORTAL_SUPABASE_SECRET_KEY=replace-me
# Dedicated portal_runtime pooler connection: schema portal only.
PORTAL_AUTH_DATABASE_URL="host=HOST port=5432 dbname=postgres user=portal_runtime.PROJECT password=REPLACE sslmode=require"
# Dedicated scouting_runtime connection: must have no COMET SELECT grants.
SCOUTING_DATABASE_URL="host=HOST port=5432 dbname=postgres user=scouting_runtime.PROJECT password=REPLACE sslmode=require"
# Dedicated read-only role with access to required public COMET tables.
COMET_DATABASE_URL="host=HOST port=5432 dbname=postgres user=comet_reader.PROJECT password=REPLACE sslmode=require"
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PORT=18502
