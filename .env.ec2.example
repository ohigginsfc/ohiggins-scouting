# Copy to .env on the EC2 server and change the password before starting.
# Docker Compose carga .env automáticamente; no hace falta source .env.

# Host port for Streamlit. Keep this unique if the EC2 already runs other apps.
SCOUTING_APP_PORT=18501

# PostgreSQL is private inside this Compose project; do not expose 5432 on the host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ohiggins_scouting_db
DB_USER=ohiggins_scouting_user
DB_PASSWORD=change_this_to_a_long_random_password

# UI / production defaults.
SCOUTING_DEBUG_MODE=0
SHOW_ADMIN_TAB=0
DISABLE_SOFASCORE_UPDATE=1
SHOW_SYNC_TECHNICAL_DETAILS=0

# Sofascore seasons used by the UI/import scripts.
SOFASCORE_ACTIVE_SEASON=2025
SOFASCORE_HISTORICAL_SEASON=2024

# Authentication (required). Generate hash, then escape each '$' as '$$' for Compose.
# python -c "import bcrypt; print(bcrypt.hashpw(b'TU_PASSWORD', bcrypt.gensalt()).decode())"
SCOUTING_USERNAME=admin
SCOUTING_PASSWORD_HASH=$$2b$$12$$L/UYocKv.O6JJprwzn4cd.nlaIU8cTgB852p2uhcuY25StwblxbGO
