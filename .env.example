# Docker Compose carga este fichero automáticamente para interpolación.
# No hace falta ejecutar: source .env
# Si una variable está exportada en el shell, tiene prioridad sobre este fichero;
# app, db-init y postgres reciben siempre el mismo valor efectivo.

# ── PostgreSQL (obligatorio) ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=scouting_db
DB_USER=scouting_user
DB_PASSWORD=change_me

# ── Temporadas ──
SOFASCORE_ACTIVE_SEASON=2025
SOFASCORE_HISTORICAL_SEASON=2024

# ── UI ──
SCOUTING_DEBUG_MODE=0
SHOW_ADMIN_TAB=0
DISABLE_SOFASCORE_UPDATE=0
SHOW_SYNC_TECHNICAL_DETAILS=0

# ── Autenticación (obligatorio) ──
SCOUTING_USERNAME=admin
# Hash bcrypt: escapar cada '$' como '$$' para que Compose no lo interprete.
# Generar: python -c "import bcrypt; print(bcrypt.hashpw(b'TU_PASSWORD', bcrypt.gensalt()).decode())"
# Ejemplo para contraseña "admin" (ya escapado para Compose):
SCOUTING_PASSWORD_HASH=$$2b$$12$$L/UYocKv.O6JJprwzn4cd.nlaIU8cTgB852p2uhcuY25StwblxbGO

# ── Bind-mount (opcional) ──
# Vacío = directorio del compose (recomendado en local).
# Solo define una ruta absoluta si el montaje debe apuntar a otro sitio.
# HOST_PROJECT_ROOT=

# ── Contraseña PostgreSQL y volúmenes ──
# DB_PASSWORD se aplica al crear el volumen. Cambiarla después no actualiza el rol.
# Desarrollo (borra datos): docker compose down -v
# Con datos: ALTER ROLE ... PASSWORD '...' (no borrar el volumen).
