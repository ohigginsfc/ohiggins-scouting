# ── Secretos y entorno ──
.env
.env.local
.env.*.local
!.env.example
!.env.ec2.example
.streamlit/secrets.toml

# ── Python / entornos virtuales ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── IDEs / editor ──
.idea/
.vscode/
*.swp
*.swo
.cursor/
!.cursor/rules/

# ── Sistema / temporales ──
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp
build_*.log

# ── Bases de datos locales / dumps ──
*.dump
*.backup
*.sql.gz
*.sqlite
*.sqlite3
scouting_db.dump
backup_before_*.sql

# ── Runtime y logs de la plataforma ──
data/backups/**
!data/backups/
!data/backups/.gitkeep

data/logs/**
!data/logs/
!data/logs/**/.gitkeep

data/runtime/**
!data/runtime/
!data/runtime/.gitkeep

data/staging/**
!data/staging/
!data/staging/**/.gitkeep

# Dumps/SQL locales en data/demo (conservar .gitkeep)
data/demo/*.sql
data/demo/*.dump

# ── Salida Sofascore / scraper (generada) ──
web_scraping_sofascore/sofascore_output/**
!web_scraping_sofascore/sofascore_output/
!web_scraping_sofascore/sofascore_output/.gitkeep

web_scraping_sofascore/debug_sofascore/**
!web_scraping_sofascore/debug_sofascore/
!web_scraping_sofascore/debug_sofascore/.gitkeep

**/checkpoint_raw.json
**/_backup_reagg_*/
**/_backup_restore_*/
**/_tmp_*/

# ── Cachés de navegador / Selenium ──
**/chrome_profile*/
**/chromium_profile*/
**/.com.google.Chrome*
**/selenium_cache/
**/Singleton*

# ── No versionar Compose de prueba local ──
docker-compose.init-test.yml
docker-compose.override.yml
docker-compose.audit-clean.yml

.local_checks/
