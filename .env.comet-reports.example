# Worker privado de reportes. Copiar a .env.comet-reports.local (ignorado).
COMET_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
COMET_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_KEY
GOOGLE_SV_B64=YOUR_BASE64_SERVICE_ACCOUNT_JSON
COMET_REPORT_SHEET_ID=YOUR_REPORT_SPREADSHEET_ID
COMET_REPORT_SEASON=2026
# Conexiones independientes: lectura COMET y configuración/registro del portal.
COMET_DATABASE_URL=postgresql://comet_reader:YOUR_PASSWORD@YOUR_POOLER:5432/postgres?sslmode=require
PORTAL_AUTH_DATABASE_URL=postgresql://portal_runtime:YOUR_PASSWORD@YOUR_POOLER:5432/postgres?sslmode=require
COMET_REPORT_SMTP_HOST=smtp.gmail.com
COMET_REPORT_SMTP_PORT=465
COMET_REPORT_SMTP_USER=YOUR_GMAIL_ACCOUNT
COMET_REPORT_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
COMET_REPORT_NOTIFICATION_TO=operator@example.org
# El resumen deportivo usa los destinatarios confirmados en el portal.
COMET_DIGEST_SMTP_HOST=smtp.gmail.com
COMET_DIGEST_SMTP_PORT=465
COMET_DIGEST_SMTP_FROM=YOUR_GMAIL_ACCOUNT
COMET_DIGEST_SMTP_USER=YOUR_GMAIL_ACCOUNT
COMET_DIGEST_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
